{
    "name": "typdy/laravel-starter-kit",
    "description": "A comprehensive Laravel Starter Kit for typdy client applications.",
    "keywords": [
        "typdy",
        "Laravel",
        "Headless CMS",
        "Starter Kit",
        "SDK",
        "PHP",
        "API",
        "JSON API",
        "Cache",
        "Repositories",
        "Models",
        "Webhooks"
    ],
    "homepage": "https://typdy.com/docs/starter-kit/laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "George Palmer",
            "email": "george@typdy.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "illuminate/collections": "^13.0",
        "illuminate/container": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/pagination": "^13.0",
        "kamermans/guzzle-oauth2-subscriber": "^1.1",
        "laravel/prompts": "^0.3.21",
        "typedcms/php-starter-kit": "develop-dev"
    },
    "require-dev": {
        "carthage-software/mago": "^1.44.0",
        "illuminate/collections": "^13.0",
        "illuminate/container": "^13.0",
        "illuminate/pagination": "^13.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.2",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Typdy\\StarterKit\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Typdy\\StarterKit\\Laravel\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare",
            "@php ./vendor/bin/testbench package:discover --ansi"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "@build",
            "@php vendor/bin/testbench serve"
        ],
        "fmt": "mago fmt",
        "analyze": "mago analyze",
        "lint:fix": "mago lint --fix --format-after-fix",
        "lint": "mago lint",
        "test": [
            "@php vendor/bin/pest"
        ],
        "qa": [
            "composer fmt",
            "composer analyze",
            "composer test",
            "composer lint:fix",
            "composer lint"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Typdy\\StarterKit\\Laravel\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        }
    }
}
